# Mog Scan rating service — example configuration.
# Copy to .env (or export in the shell) and adjust per deployment.

# Path to the active model package (manifest.yaml + calibration.json).
# MODEL_DIR=service/models/mock-ui-v1

# Payload bounds (validated before decode).
# MAX_IMAGE_BYTES=3145728        # 3 MiB
# MAX_IMAGE_PIXELS=4000000       # decompression-bomb cap
# MAX_SCAN_ID_LEN=128

# Deadlines in seconds. Keep below the client's 8s per-request abort.
# REQUEST_DEADLINE_S=5.0
# INFERENCE_DEADLINE_S=4.0
# DECODE_DEADLINE_S=2.0

# Bounded inference: max in-flight + max queued before shedding with 503.
# MAX_CONCURRENCY=4
# MAX_QUEUE=16

# Rate limiting per privacy-preserving network key.
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_S=60.0

# Exact deployed client origins (comma-separated). Dev default: Vite server.
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Production example: CORS_ORIGINS=https://your-client.example

# ---- Shared data: sessions, registered scans, leaderboard, social ----
# SQLite database and post-media directory (runtime data; git-ignored).
# DATABASE_PATH=service/data/mog.sqlite3
# POST_MEDIA_DIR=service/data/post-media
# Display conversion for server-recorded results. The default,
# linear-1-5-plus-10-v1, maps the active model's declared native 1–5 range to
# 0–100 then adds a small 10-point display boost (capped at 100). The legacy
# heuristic-2.4-4.0-v1 floors native scores at or below 2.4 to zero.
# DISPLAY_MAP=linear-1-5-plus-10-v1

# Anonymous session cookie. Secure `__Host-mog_session` by default. Set to 0
# only for plain-HTTP localhost development (uses `mog_session_dev`).
# SESSION_COOKIE_SECURE=1
# SESSION_TTL_DAYS=365

# Exact origins allowed to send state-changing requests.
# MUTATION_ORIGINS=https://mog.zo.space,http://localhost:5173,http://localhost:5174
# Header the hosting proxy overwrites with the real client address (secondary
# rate limits only). Leave empty unless the proxy guarantees it.
# TRUSTED_CLIENT_IP_HEADER=
# Same-origin prefix the proxy maps to /v1 (used for post media URLs).
# PUBLIC_API_BASE=/api/mog

# Social limits.
# SESSION_CREATE_PER_HOUR=30
# POSTS_PER_MINUTE=5
# POSTS_PER_DAY=30
# VOTES_PER_MINUTE=60              # shared by post and comment votes
# COMMENTS_PER_MINUTE=10
# COMMENTS_PER_DAY=200
# SOCIAL_MAX_BODY_BYTES=8192
